<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\TS4Translator.Core\TS4Translator.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- CA1861 fires on EF Core's own migration codegen (array literals in generated Up/Down
         methods). Migrations are regenerated by `dotnet ef migrations add`, not hand-edited, so
         suppressing project-wide here is preferable to patching generated files after every
         migration. -->
    <NoWarn>$(NoWarn);CA1861</NoWarn>
  </PropertyGroup>

</Project>
