<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TS4Translator.App.Pages.MemoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TS4Translator.App.Pages"
    xmlns:vm="using:TS4Translator.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Memória de tradução" />

        <TextBlock
            Grid.Row="1"
            MaxWidth="900"
            HorizontalAlignment="Left"
            Opacity="0.7"
            Text="Tudo que o app já traduziu, guardado por texto original e par de idiomas — sem separação por projeto. Antes de chamar qualquer motor, uma frase que já esteja aqui é reaproveitada, então corrigir uma entrada aqui corrige todos os mods daqui em diante."
            TextWrapping="Wrap" />

        <TextBlock
            Grid.Row="2"
            FontSize="12"
            Opacity="0.75"
            Text="{x:Bind ViewModel.SummaryText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            Spacing="8">
            <TextBox
                Width="320"
                VerticalAlignment="Bottom"
                Header="Pesquisar no original ou na tradução"
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <ComboBox
                MinWidth="220"
                VerticalAlignment="Bottom"
                Header="Origem"
                ItemsSource="{x:Bind ViewModel.ProviderOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedProvider, Mode=TwoWay}" />
            <Button
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.SearchCommand}"
                Content="Buscar"
                Style="{StaticResource AccentButtonStyle}" />
            <Button
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.BackfillCommand}"
                Content="Importar traduções dos projetos"
                ToolTipService.ToolTip="Recolhe para a memória tudo que você já editou à mão ou trouxe de um chat, em todos os projetos. Antes, essas traduções ficavam só dentro do projeto." />
            <!--  A maior fonte de tradução que o app tem, e a mais barata: um pacote de tradução da
                  comunidade guarda as strings sob o mesmo KeyHash do mod original, então os dois casam
                  exatamente, sem modelo e sem adivinhação.  -->
            <Button
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ImportCommunityTranslationsCommand}"
                Content="Importar traduções da comunidade..."
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Escolha a pasta dos mods instalados e depois a pasta com os pacotes de tradução. O app casa os dois pelo identificador de cada string e guarda tudo na memória." />
            <Button
                VerticalAlignment="Bottom"
                Click="ClearProvider_Click"
                Content="Limpar tudo desta origem..."
                ToolTipService.ToolTip="Apaga todas as entradas da origem selecionada. Não afeta as traduções já aplicadas nos projetos." />
            <ProgressRing
                Width="20"
                Height="20"
                VerticalAlignment="Bottom"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <TextBlock
            Grid.Row="4"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <InfoBar
            Grid.Row="4"
            Margin="0,28,0,0"
            IsClosable="True"
            IsOpen="{x:Bind HasText(ViewModel.CommunityImportSummary), Mode=OneWay}"
            Message="{x:Bind ViewModel.CommunityImportSummary, Mode=OneWay}"
            Severity="Informational"
            Title="Traduções da comunidade" />

        <ListView Grid.Row="5" ItemsSource="{x:Bind ViewModel.Entries}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:MemoryEntryViewModel">
                    <Grid Padding="0,8,0,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            IsTextSelectionEnabled="True"
                            Text="{x:Bind Original}"
                            TextWrapping="Wrap" />

                        <!--  Editável no lugar, salvando ao sair do campo — o mesmo gesto do editor.  -->
                        <TextBox
                            Grid.Column="1"
                            AcceptsReturn="True"
                            LostFocus="TranslationTextBox_LostFocus"
                            Text="{x:Bind Translation, Mode=TwoWay}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Column="2"
                            FontSize="12"
                            Opacity="0.7"
                            Text="{x:Bind Origin, Mode=OneWay}"
                            TextWrapping="Wrap" />

                        <Button
                            Grid.Column="3"
                            VerticalAlignment="Top"
                            Click="DeleteEntry_Click"
                            Content="&#xE74D;"
                            FontFamily="{StaticResource SymbolThemeFontFamily}"
                            Tag="{x:Bind}"
                            ToolTipService.ToolTip="Remover esta entrada da memória" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel
            Grid.Row="6"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{x:Bind ViewModel.PreviousPageCommand}"
                Content="Anteriores"
                IsEnabled="{x:Bind ViewModel.CanGoToPreviousPage, Mode=OneWay}" />
            <Button
                Command="{x:Bind ViewModel.NextPageCommand}"
                Content="Próximas"
                IsEnabled="{x:Bind ViewModel.CanGoToNextPage, Mode=OneWay}" />
        </StackPanel>
    </Grid>
</Page>
