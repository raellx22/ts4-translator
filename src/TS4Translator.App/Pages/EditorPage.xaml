<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="TS4Translator.App.Pages.EditorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:TS4Translator.App.Pages"
    xmlns:vm="using:TS4Translator.App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" />

        <StackPanel
            Grid.Row="1"
            Orientation="Horizontal"
            Spacing="12">
            <Button Command="{x:Bind ViewModel.TranslateCommand}" Content="Traduzir pendentes" IsEnabled="{x:Bind Not(ViewModel.IsTranslating), Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.CancelTranslateCommand}" Content="Cancelar tradução" Visibility="{x:Bind BoolToVisibility(ViewModel.IsTranslating), Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.ExportCommand}" Content="Exportar" />
            <ProgressRing
                Width="20"
                Height="20"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="12"
            Visibility="{x:Bind BoolToVisibility(ViewModel.IsTranslating), Mode=OneWay}">
            <ProgressBar
                Width="400"
                Maximum="{x:Bind ViewModel.ProgressTotal, Mode=OneWay}"
                Value="{x:Bind ViewModel.ProgressCurrent, Mode=OneWay}" />
            <TextBlock VerticalAlignment="Center">
                <Run Text="{x:Bind ViewModel.ProgressCurrent, Mode=OneWay}" />
                <Run Text="/" />
                <Run Text="{x:Bind ViewModel.ProgressTotal, Mode=OneWay}" />
            </TextBlock>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
            <TextBox
                Width="500"
                Header="Instruções de tradução (tom, estilo - opcional)"
                Text="{x:Bind ViewModel.CustomInstructions, Mode=TwoWay}" />
            <Button Command="{x:Bind ViewModel.SaveCustomInstructionsCommand}" Content="Salvar instruções" />
        </StackPanel>

        <TextBlock
            Grid.Row="4"
            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
            TextWrapping="Wrap" />

        <StackPanel
            Grid.Row="5"
            Orientation="Horizontal"
            Spacing="12">
            <ComboBox
                ItemsSource="{x:Bind ViewModel.FilterOptions}"
                SelectedItem="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay}" />
            <TextBox
                Width="280"
                PlaceholderText="Pesquisar original ou tradução..."
                Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <ListView Grid.Row="6" ItemsSource="{x:Bind ViewModel.Strings}">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:StringRowViewModel">
                    <Grid Padding="0,8,0,8" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="180" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Grid.Column="0"
                            Text="{x:Bind Original}"
                            TextWrapping="Wrap" />
                        <TextBox
                            Grid.Column="1"
                            AcceptsReturn="True"
                            LostFocus="TranslationTextBox_LostFocus"
                            Text="{x:Bind Translation, Mode=TwoWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="2"
                            FontSize="12"
                            Opacity="0.7"
                            Text="{x:Bind StatusText, Mode=OneWay}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
